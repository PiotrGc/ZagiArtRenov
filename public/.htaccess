Options -Indexes
ServerSignature Off

# Fichiers cachés (.htaccess, .user.ini...) jamais servis
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest

RewriteEngine On

# Forcer le HTTPS en premier, pour éviter une double redirection http -> http sans .php -> https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Rediriger proprement les anciennes URLs en .php vers la version sans extension.
# Uniquement GET/HEAD : une redirection 301 sur un POST le transforme en GET
# et les données des formulaires (devis, avis, admin) seraient perdues.
RewriteCond %{THE_REQUEST} ^(GET|HEAD)\ /.*\.php[\ ?] [NC]
RewriteRule ^(.*)\.php$ /$1 [R=301,L]

# Servir le bon fichier .php en interne quand l'URL n'a pas d'extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # Le site ne charge plus rien depuis un autre domaine : tout est limité à 'self'.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
    # HSTS : n'activer qu'une fois le HTTPS vérifié en production (les navigateurs s'en souviennent 1 an).
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Ne jamais afficher les erreurs PHP aux visiteurs, mais les garder dans les logs.
# (Ce bloc ne vaut qu'avec mod_php ; en PHP-FPM, c'est public/.user.ini qui s'applique.)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>
