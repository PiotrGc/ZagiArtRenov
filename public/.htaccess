Options -Indexes
ServerSignature Off

<Files ".htaccess">
    Require all denied
</Files>

AddType application/manifest+json .webmanifest

RewriteEngine On

# Forcer le HTTPS en premier, pour éviter une double redirection http -> http sans .php -> https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Rediriger proprement les anciennes URLs en .php vers la version sans extension
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.php[\ ?] [NC]
RewriteRule ^(.*)\.php$ /$1 [R=301,L]

# Servir le bon fichier .php en interne quand l'URL n'a pas d'extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # Le site ne charge plus rien depuis un autre domaine : tout est limité à 'self'.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
    # HSTS : n'activer qu'une fois le HTTPS vérifié en production (les navigateurs s'en souviennent 1 an).
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors off
    php_value error_reporting 0
</IfModule>
