# Désactiver le listing de répertoires
Options -Indexes

# Bloquer l'accès direct au dossier vendor
RewriteEngine On
RewriteRule ^vendor/ - [F,L]

# Bloquer l'accès direct aux fichiers PHP sensibles uniquement
<FilesMatch "^(connexion|config|traitement|traitement_avis|admin_traitement|admin)\.php$">
    Require all denied
</FilesMatch>